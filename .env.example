# PostgreSQL
# Puerto publicado en el host por Docker (cambiar también DATABASE_URL para ejecutar sin Docker)
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://biblioteca:biblioteca@localhost:5432/biblioteca

# Préstamos
DIAS_PRESTAMO=14
MAX_PRESTAMOS_POR_SOCIO=3

# Multas
MULTA_ESTRATEGIA=diaria
MULTA_MONTO_DIA=50

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Autenticación / JWT
JWT_SECRET=cambiar-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# Administrador inicial (se crea al iniciar si no existe)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@biblio.test
ADMIN_PASSWORD=admin1234

# Datos de ejemplo al iniciar
SEED_DEMO_DATA=true
